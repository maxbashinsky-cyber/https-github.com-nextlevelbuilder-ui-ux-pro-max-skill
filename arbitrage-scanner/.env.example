# ---- Data source ---------------------------------------------------------
# Get a free key at https://the-odds-api.com (500 requests/month on free tier).
ODDS_API_KEY=

# Set to 1 to run with built-in demo data instead of the live API (no key).
USE_MOCK=0

# Regions to pull books from: us, uk, eu, au (comma-separated).
ODDS_REGIONS=us,uk,eu,au

# Markets to scan: h2h (moneyline), spreads, totals (comma-separated).
ODDS_MARKETS=h2h

# Optional: restrict to specific sports (comma-separated keys), else all active.
# e.g. soccer_epl,basketball_nba,tennis_atp
SPORT_KEYS=

# ---- Arbitrage settings --------------------------------------------------
# Total stake split across the legs of each opportunity.
BANKROLL=1000

# Minimum guaranteed margin to report (0.01 = 1%). Filters out stale-price noise.
MIN_MARGIN=0.005

# ---- Notifications (configure any; console always prints) ----------------
# Telegram: create a bot via @BotFather, then get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL.
DISCORD_WEBHOOK_URL=

# Slack: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
